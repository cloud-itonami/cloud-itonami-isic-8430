;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a document-handling and verification robot
;; performs benefits-application intake, eligibility checklist completion,
;; payment record logging and appeal intake for compulsory social security
;; (ISIC 8430). Its physical work is paper: lifting archive boxes of claim
;; files onto records shelving, and wheeling a cart stacked with application
;; files from the intake counter to the back office.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isic-8430"
 :cases
 [{:id :claim-box-to-shelf
   :kind :manipulator
   :procedure "arm lifts an archive box of claim files from the intake cart onto a records shelf"
   :params {:l1-m 0.50 :l2-m 0.45 :m1-kg 4.0 :m2-kg 3.0
            :from [0.60 0.10] :to [0.25 0.80] :duration-s 3.0 :steps 500}
   :sweep {:param :payload-kg :values [2.0 4.0 6.0 8.0 12.0]}
   :quantity :peak-tau1-nm
   :limit {:max 80.0 :basis "estimate: continuous shoulder torque of a 10 kg-class collaborative arm"}
   :boundary {:lo 0.5 :hi 30.0}}
  {:id :application-cart-tipover
   :kind :transport
   :procedure "robot wheels a cart of application files (40 kg, stacked to the height swept here) from the intake counter to the back office and stops at the office door"
   :params {:mass-kg 40.0 :distance-m 40.0 :v-max-mps 1.0 :a-max-mps2 0.5
            :brake-decel-mps2 1.5 :drive-force-n 200.0 :crr 0.02
            :cog-height-m 0.40 :support-half-length-m 0.18 :payload-kg 40.0
            :max-time-s 2000.0}
   :sweep {:param :payload-cog-height-m :values [0.8 1.0 1.2 1.4 1.6]}
   :quantity :min-tipover-margin
   :limit {:min 0.30 :basis "estimate: keep 30 % of the static restoring moment in reserve for floor bumps and door thresholds"}
   :boundary {:lo 0.5 :hi 2.5}}]}
